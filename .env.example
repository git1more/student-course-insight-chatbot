# --- Database ---
DATABASE_URL=postgresql://insight:insight_pass@localhost:5432/insight_db
SECRET_KEY=change-me-to-a-long-random-string

# --- Model provider: OpenAI (default) ---
# Fill this and leave every override below commented out.
OPENAI_API_KEY=sk-proj-...

# --- Model provider: any OpenAI-compatible endpoint (optional) ---
# Chat and embeddings may point at *different* providers — that is supported.
# Leave a value blank to fall back to api.openai.com for that one service.
#
# Example A — Alibaba DashScope (Qwen) for both:
#   LLM_API_KEY=sk-xxxxxxxx
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   CHAT_MODEL=qwen-flash
#   EMBEDDING_API_KEY=sk-xxxxxxxx
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL=text-embedding-v4
#   EMBEDDING_DIMENSIONS=1536
#   EMBEDDING_BATCH_SIZE=10
#
# Example B — Zhipu chat (GLM-4-Flash, free) + DashScope embeddings:
#   LLM_API_KEY=xxxxxxxx.yyyyyyyy
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   CHAT_MODEL=glm-4-flash
#   EMBEDDING_API_KEY=sk-xxxxxxxx
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL=text-embedding-v4
#   EMBEDDING_DIMENSIONS=1536
#   EMBEDDING_BATCH_SIZE=10
#
# Example C — fully local via Ollama (no API key, no network):
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   CHAT_MODEL=qwen2.5:7b
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
#   EMBEDDING_MODEL=bge-m3
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BATCH_SIZE=16
#
# IMPORTANT: EMBEDDING_DIMENSIONS must match the vector column in the database.
# Changing it requires a full re-ingest (docker compose down -v, then up again).

# LLM_API_KEY=
# LLM_BASE_URL=
# CHAT_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BATCH_SIZE=200
